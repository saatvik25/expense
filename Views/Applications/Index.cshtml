@model IEnumerable<EALRMS.Models.Application>

@{
    ViewData["Title"] = "Application Inventory";
}

<!-- Page Header and Actions Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Application Inventory</h1>
        <p class="text-muted small mb-0">Track, inspect, and manage enterprise software systems.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-enterprise-primary" id="btn-add-application">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add Application
        </a>
    </div>
</div>

<!-- Main Table Card -->
<div class="enterprise-card">
    @if (!Model.Any())
    {
        <!-- Empty State Component -->
        <div class="empty-state" id="empty-state-container">
            <div class="empty-state-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
            </div>
            <h3 class="empty-state-title">No applications registered yet</h3>
            <p class="empty-state-text">
                Your enterprise software catalog is currently empty. Start by registering the first application system.
            </p>
            <a asp-action="Create" class="btn btn-enterprise-primary" id="empty-add-btn">
                Register First Application
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-enterprise align-middle" id="applications-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Application Name</th>
                        <th>Technology Stack</th>
                        <th>Version</th>
                        <th>Status</th>
                        <th>Registered Date</th>
                        <th class="text-end" style="width: 220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr id="app-row-@item.Id">
                            <td class="text-secondary fw-semibold">#@item.Id</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none text-dark d-block">
                                    @item.Name
                                </a>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <small class="text-muted d-inline-block text-truncate" style="max-width: 260px;">
                                        @item.Description
                                    </small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.Technology
                                </span>
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(item.Version) ? "—" : item.Version)
                            </td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge-status-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status-inactive">Inactive</span>
                                }
                            </td>
                            <td class="text-secondary small">
                                @item.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-enterprise-outline" title="View details" id="btn-details-@item.Id">
                                        View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-enterprise-outline" title="Edit application" id="btn-edit-@item.Id">
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-enterprise-outline text-danger" title="Delete application" id="btn-delete-@item.Id">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="enterprise-card-footer d-flex justify-content-between align-items-center">
            <span class="text-muted small">Showing @Model.Count() application(s)</span>
            <span class="text-muted small">Live PostgreSQL Database</span>
        </div>
    }
</div>
