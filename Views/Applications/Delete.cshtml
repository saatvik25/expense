@model EALRMS.Models.Application

@{
    ViewData["Title"] = $"Delete Application - {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <!-- Navigation breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Applications</a></li>
                <li class="breadcrumb-item active" aria-current="page">Confirm Deletion</li>
            </ol>
        </nav>

        <!-- Danger Confirmation Card -->
        <div class="enterprise-card border-danger">
            <div class="enterprise-card-header bg-danger bg-opacity-10 border-danger">
                <div class="d-flex align-items-center gap-2 text-danger">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <h1 class="h5 fw-bold mb-0">Confirm Permanent Deletion</h1>
                </div>
            </div>

            <div class="enterprise-card-body">
                <p class="text-secondary mb-3">
                    Are you sure you want to permanently delete this application from the enterprise registry? This action cannot be undone.
                </p>

                <div class="bg-light p-3 rounded border mb-4">
                    <div class="mb-2">
                        <span class="text-muted small">Application ID:</span>
                        <span class="fw-bold text-dark">#@Model.Id</span>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small">Application Name:</span>
                        <span class="fw-bold text-dark">@Model.Name</span>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small">Technology Stack:</span>
                        <span class="badge bg-secondary">@Model.Technology</span>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small">Current Version:</span>
                        <span>@(string.IsNullOrEmpty(Model.Version) ? "—" : Model.Version)</span>
                    </div>
                    <div>
                        <span class="text-muted small">Status:</span>
                        @if (Model.Status == "Active")
                        {
                            <span class="badge-status-active">Active</span>
                        }
                        else
                        {
                            <span class="badge-status-inactive">Inactive</span>
                        }
                    </div>
                </div>

                <form asp-action="Delete" method="post" id="delete-app-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-flex align-items-center justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-enterprise-outline" id="btn-cancel-delete">
                            Cancel, Keep Application
                        </a>
                        <button type="submit" class="btn btn-enterprise-danger" id="btn-confirm-delete">
                            Yes, Delete Application
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
