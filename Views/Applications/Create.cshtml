@model EALRMS.Models.Application

@{
    ViewData["Title"] = "Register Application";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <!-- Navigation breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Applications</a></li>
                <li class="breadcrumb-item active" aria-current="page">Register New</li>
            </ol>
        </nav>

        <!-- Form Card -->
        <div class="enterprise-card">
            <div class="enterprise-card-header">
                <h1 class="h4 fw-bold text-dark mb-1">Register New Application</h1>
                <p class="text-muted small mb-0">Provide core architectural details to add this system to enterprise inventory.</p>
            </div>
            
            <div class="enterprise-card-body">
                <form asp-action="Create" method="post" id="create-app-form">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <!-- Application Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label required">Application Name *</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Core Banking API, Customer Portal" id="input-name" />
                        <span asp-validation-for="Name" class="field-validation-error"></span>
                        <div class="form-text">Unique title representing the system within the company.</div>
                    </div>

                    <!-- Technology Stack -->
                    <div class="mb-3">
                        <label asp-for="Technology" class="form-label required">Technology Stack *</label>
                        <input asp-for="Technology" class="form-control" placeholder="e.g. .NET 10, React, PostgreSQL, Python" id="input-technology" />
                        <span asp-validation-for="Technology" class="field-validation-error"></span>
                        <div class="form-text">Primary framework, programming language, or platform stack.</div>
                    </div>

                    <div class="row">
                        <!-- Version -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Version" class="form-label">Version</label>
                            <input asp-for="Version" class="form-control" placeholder="e.g. 1.0.0 or 2.4-preview" id="input-version" />
                            <span asp-validation-for="Version" class="field-validation-error"></span>
                            <div class="form-text">Semantic version currently running in staging or production.</div>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label">Lifecycle Status *</label>
                            <select asp-for="Status" class="form-select" id="select-status">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="field-validation-error"></span>
                            <div class="form-text">Mark active for live systems, inactive for deprecated systems.</div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief summary of business goals and architecture..." id="input-description"></textarea>
                        <span asp-validation-for="Description" class="field-validation-error"></span>
                        <div class="form-text">High-level overview of the application's domain and responsibilities (max 500 characters).</div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-enterprise-outline" id="btn-cancel">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-enterprise-primary" id="btn-submit-create">
                            Register Application
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
